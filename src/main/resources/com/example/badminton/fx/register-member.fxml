<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>

<!-- หน้าต่างสมัครสมาชิก (เปิดเป็นหน้าต่าง modal จาก RegisterMemberController.showDialog) -->
<BorderPane fx:id="root" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.example.badminton.fx.RegisterMemberController">
    <center>
        <GridPane hgap="8" vgap="8">
            <padding><Insets top="16" right="16" bottom="8" left="16"/></padding>
            <columnConstraints>
                <ColumnConstraints/>
                <ColumnConstraints hgrow="ALWAYS" minWidth="260"/>
            </columnConstraints>
            <Label text="สมัครสมาชิก" styleClass="page-title" GridPane.columnSpan="2"/>
            <Label text="ชื่อ-นามสกุล:" GridPane.rowIndex="1"/>
            <TextField fx:id="nameField" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
            <Label text="เบอร์โทรศัพท์:" GridPane.rowIndex="2"/>
            <TextField fx:id="phoneField" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
            <Label fx:id="errorLabel" styleClass="error-text" wrapText="true" maxWidth="400"
                   GridPane.rowIndex="3" GridPane.columnSpan="2"/>
        </GridPane>
    </center>
    <bottom>
        <HBox alignment="CENTER_RIGHT" spacing="8">
            <padding><Insets top="4" right="16" bottom="12" left="16"/></padding>
            <!-- cancelButton = กด Esc, defaultButton = กด Enter ที่ช่องไหนก็ได้ -->
            <Button text="ยกเลิก" cancelButton="true" onAction="#cancel"/>
            <Button text="สมัครสมาชิก" styleClass="primary-button" defaultButton="true" onAction="#register"/>
        </HBox>
    </bottom>
</BorderPane>
