<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.TitledPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.VBox?>

<!-- แท็บ "จัดการสินค้า": ตารางสินค้า (กลาง) + ฟอร์มเพิ่มสินค้า/แก้ราคา (ขวา) -->
<BorderPane fx:id="root" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.example.badminton.fx.admin.ProductManageController">
    <padding><Insets top="10" right="10" bottom="10" left="10"/></padding>

    <center>
        <!-- ลำดับคอลัมน์ต้องตรงกับ setColumnValues ใน ProductManageController -->
        <TableView fx:id="table">
            <columns>
                <TableColumn text="รหัส" prefWidth="80"/>
                <TableColumn text="ชื่อสินค้า" prefWidth="260"/>
                <TableColumn text="ราคา (บาท)" prefWidth="120"/>
            </columns>
        </TableView>
    </center>

    <right>
        <VBox spacing="10" prefWidth="360">
            <BorderPane.margin><Insets left="10"/></BorderPane.margin>
            <TitledPane text="เพิ่มสินค้าใหม่" collapsible="false" styleClass="section">
                <GridPane hgap="8" vgap="8">
                    <columnConstraints>
                        <ColumnConstraints/>
                        <ColumnConstraints hgrow="ALWAYS"/>
                    </columnConstraints>
                    <Label text="ชื่อสินค้า:"/>
                    <TextField fx:id="nameField" GridPane.columnIndex="1"/>
                    <Label text="ราคา (บาท):" GridPane.rowIndex="1"/>
                    <TextField fx:id="priceField" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
                    <Button text="เพิ่มสินค้า" styleClass="primary-button" maxWidth="Infinity" onAction="#addProduct"
                            GridPane.rowIndex="2" GridPane.columnSpan="2"/>
                </GridPane>
            </TitledPane>
            <TitledPane text="แก้ไขราคา (เลือกสินค้าในตารางก่อน)" collapsible="false" styleClass="section">
                <GridPane hgap="8" vgap="8">
                    <columnConstraints>
                        <ColumnConstraints/>
                        <ColumnConstraints hgrow="ALWAYS"/>
                    </columnConstraints>
                    <Label text="ราคาใหม่ (บาท):"/>
                    <TextField fx:id="newPriceField" GridPane.columnIndex="1"/>
                    <Button text="แก้ราคาสินค้าที่เลือก" maxWidth="Infinity" onAction="#changePrice"
                            GridPane.rowIndex="1" GridPane.columnSpan="2"/>
                </GridPane>
            </TitledPane>
        </VBox>
    </right>
</BorderPane>
