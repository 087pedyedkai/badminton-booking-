<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TitledPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>

<!-- แท็บ "ประวัติการจองของสมาชิก": เลือกสมาชิก (บน) + รายงานข้อความ (กลาง) -->
<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.example.badminton.fx.admin.MemberHistoryController">
    <padding><Insets top="10" right="10" bottom="10" left="10"/></padding>

    <top>
        <HBox alignment="CENTER_LEFT" spacing="6">
            <padding><Insets bottom="8"/></padding>
            <Label text="เลือกสมาชิก:"/>
            <ComboBox fx:id="memberCombo" onAction="#showHistory"/>
            <Button text="แสดงประวัติ" styleClass="primary-button" onAction="#showHistory"/>
        </HBox>
    </top>

    <center>
        <TitledPane text="ประวัติการจอง" collapsible="false" styleClass="section" maxHeight="Infinity">
            <TextArea fx:id="reportArea" editable="false" wrapText="false"/>
        </TitledPane>
    </center>
</BorderPane>
