<?xml version="1.0" encoding="UTF-8"?>

<?import com.example.badminton.fx.DateBox?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TitledPane?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<!-- แท็บ "รายงานรายได้": เลือกช่วงเวลา (บน) + ตารางรายได้แยกหมวด (กลาง) -->
<BorderPane fx:id="root" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.example.badminton.fx.admin.IncomeReportController">
    <padding><Insets top="10" right="10" bottom="10" left="10"/></padding>

    <fx:define>
        <ToggleGroup fx:id="typeGroup"/>
    </fx:define>

    <top>
        <TitledPane text="เลือกช่วงเวลา" collapsible="false" styleClass="section">
            <BorderPane.margin><Insets bottom="8"/></BorderPane.margin>
            <VBox spacing="6">
                <HBox alignment="CENTER_LEFT" spacing="6">
                    <RadioButton fx:id="dailyRadio" text="รายวัน" toggleGroup="$typeGroup" selected="true"
                                 onAction="#updateInputs"/>
                    <DateBox fx:id="dateBox"/>
                </HBox>
                <HBox alignment="CENTER_LEFT" spacing="6">
                    <RadioButton fx:id="monthlyRadio" text="รายเดือน" toggleGroup="$typeGroup"
                                 onAction="#updateInputs"/>
                    <Label text="เดือน:"/>
                    <ComboBox fx:id="monthCombo"/>
                    <Label text="ปี (ค.ศ.):"/>
                    <Spinner fx:id="yearSpinner" editable="true" prefWidth="100"/>
                    <Button text="แสดงรายงาน" styleClass="primary-button" onAction="#showReport"/>
                </HBox>
            </VBox>
        </TitledPane>
    </top>

    <center>
        <VBox spacing="6">
            <Label fx:id="titleLabel" styleClass="page-title"/>
            <!-- ลำดับคอลัมน์ต้องตรงกับ setColumnValues ใน IncomeReportController -->
            <TableView fx:id="table" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn text="หมวดรายได้" prefWidth="250"/>
                    <TableColumn text="ยอดเงิน (บาท)" prefWidth="180"/>
                    <TableColumn text="สัดส่วน" prefWidth="120"/>
                </columns>
            </TableView>
            <Label fx:id="totalLabel" styleClass="big-number"/>
            <Label fx:id="noteLabel" styleClass="muted" wrapText="true"/>
        </VBox>
    </center>
</BorderPane>
